// Firestore security rules — mirror of what's deployed in the Firebase
// Console. This file lives in the repo so we have a shared source of
// truth for what permissions look like across the app's collections.
//
// IMPORTANT: This file is not deployed automatically. After editing,
// copy the contents into the Firebase Console (Firestore → Rules) and
// publish, OR set up `firebase deploy --only firestore:rules` if you
// want CLI deploys. Either way, keep this file in sync with what's live.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers for THIS app's per-user collections (habits/records/notes/
    // tags/quests), which key ownership on a `userId` field in each doc.
    function signedIn()     { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.userId == request.auth.uid; }

    // -------- users subtree --------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /friendSubscriptions/{friendUid} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /blocks/{blockedUid} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /pushTokens/{docId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // -------- Favorites --------
    match /Favorites/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // -------- Friends doc (array) --------
    match /Friends/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // -------- FriendEdges --------
    match /FriendEdges/{edgeId} {
      function authed()         { return request.auth != null; }
      function isParticipant(d) {
        return authed()
               && d != null
               && d.uids is list
               && d.uids.size() == 2
               && d.uids.hasAny([request.auth.uid]);
      }
      allow read: if isParticipant(resource.data);
      allow create: if authed()
                    && request.resource.data.uids is list
                    && request.resource.data.uids.size() == 2
                    && request.resource.data.uids.hasAny([request.auth.uid])
                    && request.resource.data.uids[0] != request.resource.data.uids[1];
      allow delete: if isParticipant(resource.data);
      allow update: if false;
    }

    // -------- FriendRequests --------
    match /FriendRequests/{requestId} {
      function authed()        { return request.auth != null; }
      function sender(d)       { return authed() && d.senderUid == request.auth.uid; }
      function receiver(d)     { return authed() && d.receiverUid == request.auth.uid; }
      function isParticipant(d){ return authed() && (sender(d) || receiver(d)); }

      allow create: if authed()
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.status == "pending";
      allow read: if isParticipant(resource.data);
      allow update: if authed() && (
        (receiver(resource.data) && resource.data.status == "pending" &&
          (request.resource.data.status == "accepted" || request.resource.data.status == "rejected"))
        ||
        (sender(resource.data) && resource.data.status == "pending" &&
          request.resource.data.status == "cancelled")
      );
      allow delete: if isParticipant(resource.data) && resource.data.status != "pending";
    }

    // -------- Beacons + ChatMessages --------
    match /Beacons/{beaconId} {
      function authed()     { return request.auth != null; }
      function isOwner()    { return authed() && resource.data.ownerUid == request.auth.uid; }
      function isAllowed()  {
        return authed()
               && resource.data.allowedUids is list
               && resource.data.allowedUids.hasAny([request.auth.uid]);
      }
      function currentInUids() {
        return (resource.data.inUids is list) ? resource.data.inUids : [];
      }

      allow read: if true;
      allow create: if authed()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if authed() && (
        isOwner() ||
        (
          isAllowed() &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['inUids','updatedAt']) &&
          request.resource.data.inUids is list &&
          request.resource.data.inUids.hasAll(currentInUids()) &&
          request.resource.data.inUids.size() >= currentInUids().size()
        )
      );
      allow delete: if isOwner();

      match /ChatMessages/{msgId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
        allow update: if false;
      }
    }

    // -------- Profiles + lists subcollection --------
    match /Profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /lists/{listId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // -------- FriendGroups --------
    match /FriendGroups/{groupId} {
      function authed()     { return request.auth != null; }
      function isOwner()    { return authed() && resource.data.ownerUid == request.auth.uid; }
      function ownerStable(){ return authed() && request.resource.data.ownerUid == request.auth.uid; }

      allow read: if isOwner();
      allow create: if ownerStable()
                    && request.resource.data.name is string
                    && request.resource.data.memberUids is list;
      allow update: if isOwner()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.diff(resource.data).changedKeys()
                         .hasOnly(['name','memberUids','updatedAt']);
      allow delete: if isOwner();
    }

    // -------- Posts (top-level) + comments --------
    match /Posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;

      match /comments/{commentId} {
        function authed()    { return request.auth != null; }
        function isAuthor()  { return authed() && resource.data.authorUid == request.auth.uid; }
        function createsAsSelf() {
          return authed() && request.resource.data.authorUid == request.auth.uid;
        }
        allow read: if true;
        allow create: if createsAsSelf();
        allow update: if isAuthor();
        allow delete: if isAuthor();
      }
    }

    // -------- Reports (UGC moderation) --------
    match /Reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // -------- PushTokens --------
    match /PushTokens/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // -------- Vacation Days (habit-tracking breaks) --------
    // Doc id: `${userId}_${date}`. Each doc stores userId for queries.
    match /vacationDays/{docId} {
      function authed()    { return request.auth != null; }
      function isOwner()   { return authed() && resource.data.userId == request.auth.uid; }
      function ownsNew()   { return authed() && request.resource.data.userId == request.auth.uid; }

      allow read: if isOwner();
      allow create: if ownsNew();
      allow update: if isOwner()
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    // ============================================================
    // Escape From Hades IRL — per-user app data. Top-level collections
    // that key ownership on a `userId` field (except userSettings, whose
    // doc id IS the uid). NOTE: `list` queries MUST filter by
    // `where('userId','==', uid)` or the read will be denied.
    // ============================================================
    match /habits/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /records/{docId} {
      // `get` also allows MISSING docs (returns not-found, not denied):
      // read-then-create flows — e.g. the creative-writing auto-bump reading
      // today's record before any tap — get a missing doc, and the plain
      // ownsExisting() rule would evaluate `resource.data` on null and deny,
      // surfacing as permission-denied. Doc ids embed unguessable habit ids,
      // so allowing not-found responses leaks nothing useful.
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /notes/{docId} {
      // `get` also allows MISSING docs (returns not-found, not denied) — same
      // reasoning as `records` above. useNote() opens a single-doc listener by
      // id the instant a note is created; if that create write hasn't reached
      // the server yet, `resource` is null and the plain ownsExisting() rule
      // evaluates `resource.data` on null and DENIES — which kills the
      // listener (onSnapshot's error path doesn't retry), so the editor never
      // reflects later writes (e.g. the text→checklist flip). Note ids are
      // random, so allowing not-found responses leaks nothing.
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();

      // Per-item checklist subcollection (the "ideal" data model: one doc
      // per checklist item instead of a single array on the note). Each
      // item carries its own `userId` mirroring the parent note's owner, so
      // ownership is scoped without a get() of the parent — same shape as
      // the top-level collections above. NOTE: this rule matches only the
      // direct path /notes/{id}/items — a collectionGroup('items') query
      // would need its own `match /{path=**}/items` rule and is therefore
      // DENIED today. All readers (editor, export, account deletion) do
      // per-note userId-filtered reads, never a collection-group query.
      match /items/{itemId} {
        allow read, delete: if ownsExisting();
        allow create: if ownsIncoming();
        allow update: if ownsExisting() && ownsIncoming();
      }
    }
    match /tags/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /quests/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    // userSettings doc id == the owner's uid.
    match /userSettings/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // -------- Catch-all --------
    // SECURITY: read is DENY by default (was `if true`, which made every
    // unmatched collection — including this app's notes/habits/records/
    // tags/quests — world-readable to anyone, unauthenticated). Social-app
    // collections that need public read declare their own `allow read: if
    // true` above, so this does not affect them. If something in the OTHER
    // app on this shared project relied on the public catch-all read, add
    // an explicit rule for that collection above instead.
    match /{document=**} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.author;
    }
  }
}
