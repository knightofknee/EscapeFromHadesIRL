// Firestore security rules for Escape From Hades IRL (project: escape-from-hades-irl).
//
// Deploy with: firebase deploy --only firestore:rules
// (firebase.json already points at this file, so it is NOT a console copy-paste job.)
//
// Ownership model: every per-user collection here is a TOP-LEVEL collection whose docs carry a
// `userId` field, except userSettings, whose doc id IS the uid. Because the rules are the filter,
// any `list` query MUST include `where('userId','==', uid)` or the read is denied.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()     { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.userId == request.auth.uid; }

    match /habits/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /records/{docId} {
      // `get` also allows MISSING docs (returns not-found, not denied):
      // read-then-create flows — e.g. the creative-writing auto-bump reading
      // today's record before any tap — get a missing doc, and the plain
      // ownsExisting() rule would evaluate `resource.data` on null and deny,
      // surfacing as permission-denied. Doc ids embed unguessable habit ids,
      // so allowing not-found responses leaks nothing useful.
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /notes/{docId} {
      // `get` also allows MISSING docs (returns not-found, not denied) — same
      // reasoning as `records` above. useNote() opens a single-doc listener by
      // id the instant a note is created; if that create write hasn't reached
      // the server yet, `resource` is null and the plain ownsExisting() rule
      // evaluates `resource.data` on null and DENIES — which kills the
      // listener (onSnapshot's error path doesn't retry), so the editor never
      // reflects later writes (e.g. the text→checklist flip). Note ids are
      // random, so allowing not-found responses leaks nothing.
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();

      // Per-item checklist subcollection (the "ideal" data model: one doc
      // per checklist item instead of a single array on the note). Each
      // item carries its own `userId` mirroring the parent note's owner, so
      // ownership is scoped without a get() of the parent — same shape as
      // the top-level collections above. NOTE: this rule matches only the
      // direct path /notes/{id}/items — a collectionGroup('items') query
      // would need its own `match /{path=**}/items` rule and is therefore
      // DENIED today. All readers (editor, export, account deletion) do
      // per-note userId-filtered reads, never a collection-group query.
      match /items/{itemId} {
        allow read, delete: if ownsExisting();
        allow create: if ownsIncoming();
        allow update: if ownsExisting() && ownsIncoming();
      }
    }

    match /tags/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /quests/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Habit-tracking breaks. Doc id: `${userId}_${date}`; each doc also stores userId for queries.
    match /vacationDays/{docId} {
      function isOwner()   { return signedIn() && resource.data.userId == request.auth.uid; }
      function ownsNew()   { return signedIn() && request.resource.data.userId == request.auth.uid; }

      allow read: if isOwner();
      allow create: if ownsNew();
      allow update: if isOwner()
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    // userSettings doc id == the owner's uid.
    match /userSettings/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // App-level config, not user data. Config/app.latestVersion drives the
    // update nudge (lib/app-update.ts) and is compared against the running
    // binary's own version, so it must be readable BEFORE sign-in (the check
    // runs at cold start). World-readable is fine: it holds only the released
    // version string and public store links. Writes happen exclusively via
    // admin tooling (tools/setLatestVersion.js), never from clients.
    match /Config/app {
      allow read: if true;
      allow write: if false;
    }

    // -------- Catch-all --------
    // SECURITY: DENY by default across the board. Firestore uses OR-semantics over matching rules,
    // so a permissive catch-all silently OVERRIDES the strict per-collection rules above. The old
    // `allow create: if request.auth != null` let any signed-in user create docs in ANY collection,
    // including this app's habits/records/notes/tags/quests/vacationDays carrying a VICTIM's userId,
    // which the victim's `where('userId','==',uid)` listeners would then render. Every collection
    // this app uses declares its own rules above, so nothing legitimate relied on it. If a new
    // collection is added, give it an explicit owner-scoped rule above; never reopen this.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
