{
  "expo": {
    "name": "Escape from Hades IRL",
    "slug": "EscapeFromHadesIRL",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "escapefromhadesirl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.briancarlisle.escapefromhadesirl",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "We read your step count from Apple Health to auto-record your Steps Counter habit. You can disable this any time in Settings → Health."
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.briancarlisle.escapefromhadesirl",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "./plugins/ios-build-settings",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "excludedArchitectures": {
              "iphonesimulator": [
                "x86_64"
              ]
            }
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "We read your step count from Apple Health to auto-record your Steps Counter habit. You can disable this any time in Settings → Health.",
          "background": false
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13ee5fbf-4cbb-41fb-917f-b199515ad624"
      }
    }
  }
}
