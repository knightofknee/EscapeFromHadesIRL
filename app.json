{
  "expo": {
    "name": "Escape from Hades IRL",
    "slug": "EscapeFromHadesIRL",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "escapefromhadesirl",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.briancarlisle.escapefromhadesirl",
      "appleTeamId": "R3H7M2M4F5",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "We read your step count from Apple Health to auto-record your Steps Counter habit. You can disable this any time in Settings → Health.",
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.briancarlisle.escapefromhadesirl",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "We access the photo you pick so it can be used as a habit tile icon. Nothing else in your library is read."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "excludedArchitectures": {
              "iphonesimulator": [
                "x86_64"
              ]
            }
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "We read your step count from Apple Health to auto-record your Steps Counter habit. You can disable this any time in Settings → Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/bell.wav",
            "./assets/alarm.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13ee5fbf-4cbb-41fb-917f-b199515ad624",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "MeditationWidget",
                  "bundleIdentifier": "com.briancarlisle.escapefromhadesirl.MeditationWidget",
                  "entitlements": {}
                }
              ]
            }
          }
        }
      }
    }
  }
}
