rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Per-user namespace: a user may read/write only under their own uid.
    // Uploads must be images and under 10 MB.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else: deny. (The app currently uses no Storage paths; this
    // keeps the bucket closed by default rather than in test/allow-all mode.)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
